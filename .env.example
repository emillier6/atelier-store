# Neon Postgres connection string (use the pooled URL from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (test mode). Secret key: Dashboard → Developers → API keys.
# Webhook secret: printed by
#   stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
